# Copy to .env beside compose.yaml and change what you need. Docker Compose reads it on
# every command. Keep it private once it holds passwords or keys.

# Where your music is on this machine. Mounted read-only.
MUSIC_DIR=/srv/music

# Pin a release instead of following latest, for example 1.2.0 (and 1.2.0-acquire).
# TRACKSIDE_TAG=latest
# TRACKSIDE_ACQUIRE_TAG=acquire

# The port on this machine.
# TRACKSIDE_PORT=4747

# Your time zone, used for the nightly backup schedule.
# TZ=Europe/London

# Layer the optional files on every command instead of passing -f each time.
# Separate them with ":" (";" on Windows). compose.build.yaml goes last.
# COMPOSE_FILE=compose.yaml:compose.acquire.yaml
# COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
# COMPOSE_FILE=compose.yaml:compose.build.yaml

# --- compose.build.yaml -------------------------------------------------------------------
# What to build: standard, slim or acquire (acquire with compose.acquire.yaml).
# TRACKSIDE_BUILD_TARGET=standard
# A branch, a release tag (trackside-v1.2.0) or a full commit hash.
# TRACKSIDE_BUILD_REF=main

# --- compose.tailscale.yaml ---------------------------------------------------------------
# An auth key from https://login.tailscale.com/admin/settings/keys
# TS_AUTHKEY=
# TS_HOSTNAME=trackside
# TRACKSIDE_TAILNET_URL=https://trackside.your-tailnet.ts.net
