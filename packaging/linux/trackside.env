# Environment for the trackside systemd service. Every setting in config.toml can also be
# set here as TRACKSIDE_ plus the upper-cased key, with __ between levels. The full list is
# in Server/docs/ops/configuration.md, and `trackside config show` prints what is in effect.
#
# After a change: sudo systemctl restart trackside

# Where the first library comes from on the first start. Also add the folder to
# ReadOnlyPaths with `sudo systemctl edit trackside` if it is not under /srv/music.
#TRACKSIDE_MUSIC_DIR=/srv/music

#TRACKSIDE_SERVER__NAME=Home
#TRACKSIDE_SERVER__PUBLIC_URLS=https://music.example.com
#TRACKSIDE_SERVER__TRUSTED_PROXIES=127.0.0.1/32,::1/128
#TRACKSIDE_LOG__LEVEL=info
